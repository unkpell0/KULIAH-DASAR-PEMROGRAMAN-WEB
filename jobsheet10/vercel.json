{
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.9.0" },
    "api/film/*.php": { "runtime": "vercel-php@0.9.0" },
    "api/anggota/*.php": { "runtime": "vercel-php@0.9.0"}
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/(.*)", "dest": "/api/$1" }
  ]
}